{
  // GitHub Codespaces: Code → Codespaces → Create codespace on main. The app starts by itself.
  "name": "Verity",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "forwardPorts": [5173, 8000],
  "portsAttributes": {
    "5173": { "label": "Verity app", "onAutoForward": "openBrowser" },
    "8000": { "label": "API (the app reaches it through port 5173)", "onAutoForward": "silent" }
  },
  // One-time: Python + npm packages, train the message checker, create .env (random secret, short test timers).
  "postCreateCommand": "bash .devcontainer/setup.sh",
  // Every start: run API (:8000) + app (:5173) in the background. Log: /tmp/ocbc-verify.log
  "postStartCommand": "bash .devcontainer/start.sh",
  "hostRequirements": { "cpus": 2 }
}
