# Copy to .env and change values. Never commit .env.
DATABASE_URL=sqlite:///./safebank.db
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# --- Test-environment timers (there are NO timer buttons in the app) -------------------------
# Save-for-later choices offered to the customer, in minutes. Real default: 1 h / 6 h / 24 h.
# Testers may use short values, e.g. SAVE_FOR_LATER_OPTIONS_MINUTES=1,3,5
SAVE_FOR_LATER_OPTIONS_MINUTES=60,360,1440
# How long a trusted contact has to reply before the customer sees the "no answer yet" path.
TRUSTED_CONTACT_TIMEOUT_MINUTES=1440
# Cooling period before a trusted-contact change/removal takes effect.
CONTACT_CHANGE_COOLING_MINUTES=1440
# Seconds before "Continue anyway" appears on the pause screen.
CONTINUE_ANYWAY_SECONDS=60
# When a phone call is part of a paused payment, "Continue anyway" unlocks only this many minutes
# after the call ends (the customer must hang up first).
HANG_UP_WAIT_MINUTES=1

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,capacitor://localhost,http://localhost
# Optional TURN server for WebRTC across different networks (same Wi-Fi works without it)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# App (Vite). Leave empty to use <same host>:8000. For the Android app set your laptop's LAN IP:
# VITE_API_URL=http://192.168.1.20:8000
VITE_API_URL=
