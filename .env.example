# Copy to .env and change values. Never commit .env.
DATABASE_URL=sqlite:///./safebank.db
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# DEMO_MODE shows the /demo launcher, demo password, "Skip timer" and simulated signals.
DEMO_MODE=true
# Trusted-contact reply window: 120 for demo, 86400 (24 h) for a real deployment.
TRUSTED_TIMEOUT_SECONDS=120
CONTINUE_ANYWAY_SECONDS=30
CONTACT_CHANGE_HOURS=24
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,capacitor://localhost,http://localhost
# Optional TURN server for WebRTC across different networks (same Wi-Fi works without it)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Frontends (Vite). Leave empty to use the same host on port 8000.
VITE_API_URL=
